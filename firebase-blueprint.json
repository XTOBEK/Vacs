{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Core identity for staff, clients, and admins.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["ADMIN", "RN", "CAREGIVER", "CLIENT"] },
        "status": { "type": "string", "enum": ["PENDING", "ACTIVE", "SUSPENDED"] },
        "kitVerified": { "type": "boolean" },
        "guarantorVerified": { "type": "boolean" },
        "region": { "type": "string" },
        "assignedCaregiverId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLocation": { 
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "timestamp": { "type": "string" }
          }
        }
      },
      "required": ["uid", "fullName", "email", "role"]
    },
    "Wallet": {
      "title": "Digital Wallet",
      "description": "Balance and financial state for users.",
      "type": "object",
      "properties": {
        "balance": { "type": "number" },
        "currency": { "type": "string" },
        "lastTopUp": { "type": "string" },
        "bankAccount": {
           "type": "object",
           "properties": {
              "bankName": { "type": "string" },
              "accountNumber": { "type": "string" },
              "accountName": { "type": "string" }
           }
        }
      }
    },
    "Shift": {
      "title": "Clinical Shift",
      "description": "A scheduled or active care session.",
      "type": "object",
      "properties": {
        "caregiverId": { "type": "string" },
        "clientId": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["SCHEDULED", "ONGOING", "COMPLETED", "HOSPITALIZED"] },
        "transportFee": { "type": "number" },
        "checkInLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        }
      },
      "required": ["caregiverId", "clientId", "status"]
    },
    "DailyCareLog": {
      "title": "Daily Care Log",
      "description": "Vitals and daily metrics recorded during a shift.",
      "type": "object",
      "properties": {
        "shiftId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "vitals": {
          "type": "object",
          "properties": {
            "temp": { "type": "number" },
            "heartRate": { "type": "number" },
            "systolic": { "type": "number" },
            "diastolic": { "type": "number" },
            "oxygen": { "type": "number" }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "AppSetting": {
      "title": "Global System Settings",
      "description": "CMS and architecture constants.",
      "type": "object",
      "properties": {
        "tierRates": { "type": "object" },
        "transportZoneFees": { "type": "object" },
        "landingPageCopy": { "type": "object" }
      }
    },
    "ExamDefinition": {
      "title": "Exam Blueprint",
      "description": "Master definitions for training assessments.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "q": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } },
              "correctAnswer": { "type": "string" }
            }
          }
        },
        "passingScore": { "type": "number" },
        "isPublished": { "type": "boolean" }
      }
    },
    "Assessment": {
      "title": "Exam Submission",
      "description": "Student submission waiting to be graded.",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "studentId": { "type": "string" },
        "answers": { "type": "array", "items": { "type": "string" } },
        "score": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "PASSED", "FAILED"] },
        "submittedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Primary identity registry"
    },
    "/users/{userId}/wallet/main": {
      "schema": "Wallet",
      "description": "Financial state for payments"
    },
    "/shifts/{shiftId}": {
      "schema": "Shift",
      "description": "Shift and log registry"
    },
    "/shifts/{shiftId}/logs/{logId}": {
      "schema": "DailyCareLog",
      "description": "Clinical vitals feed"
    },
    "/settings/global": {
      "schema": "AppSetting",
      "description": "Dynamic CMS node"
    },
    "/exams/{examId}": {
      "schema": "ExamDefinition",
      "description": "Master assessments"
    },
    "/exams/{examId}/assessments/{assessmentId}": {
      "schema": "Assessment",
      "description": "Graded submissions"
    }
  }
}
