rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "princewill.iwuoha@gmail.com" || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    
    // Schema validation helpers
    function isValidUser(data) {
        return data.keys().hasAll(['uid', 'fullName', 'email', 'role']) 
            && data.uid is string && (data.uid == request.auth.uid || isAdmin())
            && data.fullName is string && data.fullName.size() <= 100
            && data.email is string && data.email.matches('^[^@]+@[^@]+\\.[^@]+$')
            && data.role in ['ADMIN', 'RN', 'CAREGIVER', 'CLIENT'];
    }

    // --- Global Catch-all ---
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    // --- Collections ---
    
    match /users/{userId} {
        // Least Privilege: Users see themselves. Caregivers see assigned clients. Admins see all.
        allow read: if isSignedIn() && (
            request.auth.uid == userId || 
            isAdmin() || 
            (get(/databases/$(database)/documents/users/$(userId)).data.role == 'CLIENT' && 
             get(/databases/$(database)/documents/users/$(userId)).data.assignedCaregiverId == request.auth.uid)
        );
        
        allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUser(incoming());
        
        allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin())
            && (
                isAdmin() || 
                (incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'lastLocation', 'status', 'assignedCaregiverId', 'verificationStatus', 'kitStatus', 'supervisorId', 'clinicalData', 'shiftStatus', 'lastClockIn'])
                 && (incoming().status == existing().status))
            );

        allow delete: if isAdmin();
            
        match /wallet/main {
            allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
            allow write: if isAdmin(); // Only admins/system can update wallets
        }
    }
    
    match /shifts/{shiftId} {
        allow read: if isSignedIn() && (resource.data.caregiverId == request.auth.uid || resource.data.clientId == request.auth.uid || isAdmin());
        
        // Only Admins or assigned Caregivers can create shifts (usually admins schedule them)
        allow create: if isAdmin(); 
        
        allow update: if isSignedIn() && (resource.data.caregiverId == request.auth.uid || isAdmin());
        
        match /logs/{logId} {
             allow read: if isSignedIn() && (get(/databases/$(database)/documents/shifts/$(shiftId)).data.caregiverId == request.auth.uid || get(/databases/$(database)/documents/shifts/$(shiftId)).data.clientId == request.auth.uid || isAdmin());
             allow create: if isSignedIn() && (get(/databases/$(database)/documents/shifts/$(shiftId)).data.caregiverId == request.auth.uid);
        }
    }
    
    match /invoices/{invoiceId} {
        allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || isAdmin());
        allow write: if isAdmin();
    }

    match /payouts/{payoutId} {
        allow read: if isSignedIn() && (resource.data.caregiverId == request.auth.uid || isAdmin());
        allow write: if isAdmin();
    }
    
    match /exams/{examId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
        
        match /assessments/{assessmentId} {
            allow read: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin());
            allow create: if isSignedIn() && incoming().studentId == request.auth.uid && incoming().status == 'PENDING';
            allow update: if isAdmin(); 
        }
    }

    match /clients/{clientId} {
        allow read, write: if isAdmin();
    }

    match /settings/global {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }

    match /templates/{templateId} {
        allow read, write: if isAdmin();
    }

    match /cms/{contentId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    match /applications/{appId} {
        allow read: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
        allow create: if true; 
        allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow write: if isAdmin();
    }
  }
}
