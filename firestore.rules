rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "princewill.iwuoha@gmail.com" || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    
    // Schema validation helpers
    function isValidUser(data) {
        return data.keys().hasAll(['uid', 'fullName', 'email', 'role']) 
            && data.uid is string && data.uid == request.auth.uid 
            && data.fullName is string && data.fullName.size() <= 100
            && data.email is string && data.email.matches('^[^@]+@[^@]+\\.[^@]+$')
            && data.role in ['ADMIN', 'RN', 'CAREGIVER', 'CLIENT'];
    }

    // --- Global Catch-all ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Collections ---
    
    match /users/{userId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        
        allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
        
        allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin())
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'lastLocation', 'status', 'assignedCaregiverId', 'verificationStatus', 'kitStatus', 'supervisorId'])
            && (incoming().status == existing().status || isAdmin());
            
        match /wallet/main {
            allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        }
    }
    
    match /shifts/{shiftId} {
        allow read: if isSignedIn() && (resource.data.caregiverId == request.auth.uid || resource.data.clientId == request.auth.uid || isAdmin());
        
        allow create: if isSignedIn() && (incoming().caregiverId == request.auth.uid || incoming().clientId == request.auth.uid);
        
        match /logs/{logId} {
             allow read: if isSignedIn() && (get(/databases/$(database)/documents/shifts/$(shiftId)).data.caregiverId == request.auth.uid || isAdmin());
             allow create: if isSignedIn() && (get(/databases/$(database)/documents/shifts/$(shiftId)).data.caregiverId == request.auth.uid);
        }
    }
    
    match /exams/{examId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
        
        match /assessments/{assessmentId} {
            allow read: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin());
            allow create: if isSignedIn() && incoming().studentId == request.auth.uid && incoming().status == 'PENDING';
            allow update: if isAdmin(); 
        }
    }

    match /settings/global {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }
  }
}
